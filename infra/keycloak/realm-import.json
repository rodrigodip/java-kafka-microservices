{
  "realm": "java-ms-kafka",
  "enabled": true,
  "sslRequired": "external",
  "roles": {
    "realm": [
      { "name": "customer", "description": "End customer" },
      { "name": "operator", "description": "Backoffice operator" },
      { "name": "admin", "description": "Administrator" }
    ]
  },
  "clients": [
    {
      "clientId": "api",
      "name": "API client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:*", "http://localhost:8086/*"],
      "webOrigins": ["+"]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Customer",
      "email": "alice@example.com",
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }],
      "realmRoles": ["customer"]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Operator",
      "email": "bob@example.com",
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }],
      "realmRoles": ["operator"]
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Admin",
      "email": "admin@example.com",
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["admin"]
    }
  ]
}
